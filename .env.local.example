# .env.local.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Your development machine's LAN IP address.
# Find it with: ifconfig | grep inet (macOS/Linux) or ipconfig (Windows)
# Do NOT use "localhost" — on a physical device that refers to the device itself.
EXPO_PUBLIC_API_URL=http://192.168.1.42:4000/api/v1

# Which environment profile to use for config resolution
EXPO_PUBLIC_APP_ENV=development
