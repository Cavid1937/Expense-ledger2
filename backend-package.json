{
  "name": "expense-ledger-api",
  "version": "1.0.0",
  "description": "Expense Ledger – REST API",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start":       "node server.js",
    "dev":         "nodemon server.js",
    "migrate":     "knex migrate:latest",
    "migrate:down":"knex migrate:rollback",
    "seed":        "knex seed:run",
    "test":        "jest --runInBand --forceExit",
    "test:watch":  "jest --watch",
    "lint":        "eslint src/ --ext .js"
  },
  "dependencies": {
    "express":              "^4.18.2",
    "cors":                 "^2.8.5",
    "helmet":               "^7.1.0",
    "compression":          "^1.7.4",
    "morgan":               "^1.10.0",

    "knex":                 "^3.1.0",
    "pg":                   "^8.11.3",

    "redis":                "^4.6.10",
    "ioredis":              "^5.3.2",

    "jsonwebtoken":         "^9.0.2",
    "bcryptjs":             "^2.4.3",
    "uuid":                 "^9.0.0",

    "zod":                  "^3.22.4",
    "express-rate-limit":   "^7.1.5",

    "multer":               "^1.4.5-lts.1",
    "aws-sdk":              "^2.1490.0",

    "node-cron":            "^3.0.3",
    "date-fns":             "^2.30.0",
    "date-fns-tz":          "^2.0.0",

    "winston":              "^3.11.0",
    "dotenv":               "^16.3.1",
    "express-async-errors": "^3.1.1",

    "plaid":                "^18.0.0",
    "firebase-admin":       "^12.0.0"
  },
  "devDependencies": {
    "nodemon":              "^3.0.2",
    "jest":                 "^29.7.0",
    "supertest":            "^6.3.3",
    "eslint":               "^8.54.0"
  }
}
